generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum MemberStatus {
  ACTIVE
  PAUSED
  CANCELLED
  LEAD
}

model User {
  id          String       @id @default(cuid())
  name        String
  email       String       @unique
  phone       String?
  status      MemberStatus @default(LEAD)
  memberships Membership[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  notes       String?      @db.Text

  @@index([status])
  @@index([createdAt])
}

model Membership {
  id         String    @id @default(cuid())
  planName   String
  priceCents Int
  startDate  DateTime
  endDate    DateTime?
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@index([userId])
}
