generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum MemberStatus {
  ACTIVE
  PAUSED
  CANCELLED
  LEAD
}

enum Role {
  ADMIN
  MANAGER
  TRAINER
  MEMBER
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  phone               String?
  status              MemberStatus         @default(LEAD)
  role                Role                 @default(MEMBER)
  passwordHash        String?
  emailVerified       DateTime?
  image               String?
  notes               String?              @db.Text
  memberships         Membership[]
  accounts            Account[]
  sessions            Session[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  passwordResetTokens PasswordResetToken[]
  classesTaught       GymClass[]           @relation("ClassTrainer")
  bookings            GymClassBooking[]
  calendarToken       String?              @unique
  paymentCustomerId   String?              @unique
  payments            Payment[]

  @@index([status])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Membership {
  id                 String           @id @default(cuid())
  planName           String
  priceCents         Int
  startDate          DateTime
  endDate            DateTime?
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId             String?
  plan               MembershipPlan?  @relation(fields: [planId], references: [id], onDelete: SetNull)
  // kind, interval, durationDays, planName and priceCents are copied from the plan at purchase time
  kind               MembershipKind   @default(ONE_TIME)
  interval           BillingInterval?
  durationDays       Int?
  currency           String           @default("usd")
  status             MembershipStatus @default(EXPIRED)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean          @default(false)
  pausedAt           DateTime?
  paymentMethodId    String?
  billingEvents      BillingEvent[]
  payments           Payment[]
  createdAt          DateTime         @default(now())

  @@index([userId])
  @@index([planId])
  @@index([status, currentPeriodEnd])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum BookingStatus {
  BOOKED
  WAITLISTED
  CANCELLED
}

model Gym {
  id        String   @id @default(cuid())
  name      String
  timeZone  String   @default("Asia/Jakarta")
  createdAt DateTime @default(now())
}

// The template: "Morning HIIT, every Saturday at 18:30"
model GymClass {
  id              String             @id @default(cuid())
  name            String
  description     String?
  trainerId       String?
  trainer         User?              @relation("ClassTrainer", fields: [trainerId], references: [id], onDelete: SetNull)
  dayOfWeek       Int // 1 = Monday ... 7 = Sunday, as seen at the gym
  startTime       String // "18:30", local time at the gym
  durationMinutes Int
  capacity        Int
  active          Boolean            @default(true)
  instances       GymClassInstance[]
  createdAt       DateTime           @default(now())

  @@index([trainerId])
}

// One dated session: "Saturday 17 October, 18:30"
model GymClassInstance {
  id       String            @id @default(cuid())
  classId  String
  gymClass GymClass          @relation(fields: [classId], references: [id], onDelete: Cascade)
  startsAt DateTime // stored in UTC
  endsAt   DateTime
  capacity Int // copied from the template, so editing the template never changes sessions already sold
  bookings GymClassBooking[]

  @@unique([classId, startsAt])
  @@index([startsAt])
}

model GymClassBooking {
  id          String           @id @default(cuid())
  instanceId  String
  instance    GymClassInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      BookingStatus    @default(BOOKED)
  createdAt   DateTime         @default(now())
  cancelledAt DateTime?

  @@unique([instanceId, userId])
  @@index([userId])
}

enum MembershipKind {
  RECURRING
  ONE_TIME
}

enum BillingInterval {
  MONTH
  YEAR
}

enum MembershipStatus {
  PENDING
  ACTIVE
  PAUSED
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum BillingEventKind {
  INITIAL
  RENEWAL
}

enum BillingEventStatus {
  PENDING
  PAID
  FAILED
}

enum DiscountType {
  PERCENT
  FIXED
}

model MembershipPlan {
  id           String           @id @default(cuid())
  name         String
  description  String?
  priceCents   Int
  currency     String           @default("usd")
  kind         MembershipKind
  interval     BillingInterval? // only for RECURRING plans
  durationDays Int? // only for ONE_TIME plans
  active       Boolean          @default(true)
  memberships  Membership[]
  createdAt    DateTime         @default(now())
}

model Discount {
  id             String         @id @default(cuid())
  code           String         @unique
  type           DiscountType
  value          Int // PERCENT: 1 to 100. FIXED: cents.
  startsAt       DateTime?
  expiresAt      DateTime?
  maxRedemptions Int?
  redeemedCount  Int            @default(0)
  active         Boolean        @default(true)
  billingEvents  BillingEvent[]
  createdAt      DateTime       @default(now())
}

// What is owed for one period of one membership.
model BillingEvent {
  id                String             @id @default(cuid())
  membershipId      String
  membership        Membership         @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  kind              BillingEventKind
  status            BillingEventStatus @default(PENDING)
  listPriceCents    Int
  discountCents     Int                @default(0)
  amountCents       Int // what is actually charged
  currency          String
  discountId        String?
  discount          Discount?          @relation(fields: [discountId], references: [id], onDelete: SetNull)
  periodStart       DateTime
  periodEnd         DateTime
  attempts          Int                @default(0) // charge attempts made by the billing engine
  failureMessage    String?
  providerSessionId String?
  payment           Payment?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  // The database itself refuses to bill the same period twice.
  @@unique([membershipId, periodStart])
  @@index([status])
}

// Money that actually moved: one row per successful charge.
model Payment {
  id                String       @id @default(cuid())
  billingEventId    String       @unique
  billingEvent      BillingEvent @relation(fields: [billingEventId], references: [id], onDelete: Cascade)
  membershipId      String
  membership        Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountCents       Int
  currency          String
  provider          String
  providerPaymentId String       @unique
  refundedCents     Int          @default(0)
  refunds           Refund[]
  createdAt         DateTime     @default(now())

  @@index([userId])
  @@index([membershipId])
}

model Refund {
  id               String   @id @default(cuid())
  paymentId        String
  payment          Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amountCents      Int
  providerRefundId String   @unique
  reason           String?
  createdById      String?
  createdAt        DateTime @default(now())

  @@index([paymentId])
}

// One row per provider event we have handled. This is what makes webhooks safe to replay.
model WebhookEvent {
  id          String   @id // "stripe:evt_123"
  type        String
  processedAt DateTime @default(now())
}
